+  // Squad-wide threat response: one enemy firing on any friendly combat unit
+  // becomes the shared target for the whole combat force, not only the victim.
+  // Non-combat logistics stay on task; explicit structure/HQ attack orders are preserved.
+  if(threatHits.size){
+    const friendlyCombat=units.filter(u=>u.faction==='player'&&u.hp>0&&u.damage>0&&UNIT_SPECS[u.kind].range>0);
+    const center=friendlyCombat.reduce((p,u)=>({x:p.x+u.x,z:p.z+u.z}),{x:0,z:0});
+    if(friendlyCombat.length){center.x/=friendlyCombat.length;center.z/=friendlyCombat.length;}
+    const sharedThreat=[...threatHits.entries()].map(([id,hits])=>({
+      unit:units.find(v=>v.id===id&&v.faction==='enemy'&&v.hp>0),hits
+    })).filter(v=>v.unit).sort((a,b)=>b.hits-a.hits||distance(a.unit!,center)-distance(b.unit!,center))[0]?.unit;
+    if(sharedThreat){
