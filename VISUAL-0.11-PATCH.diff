+    <Part p={[0,1.37,.17]} s={[.42,.07,.12]} c={dark}/>
+    <Part p={[0,.88,-.23]} s={[.36,.44,.18]} c={engineer?accent:dark}/>
+    <Part p={[0,.99,-.34]} s={[.42,.26,.12]} c={worker?'#b39b68':body}/>
+    {worker?<><Part p={[0,1.1,.19]} s={[.56,.14,.1]} c="#d4ad4d"/><Barrel p={[.38,.47,.36]} length={.9} radius={.035} c="#765f3e"/><Part p={[.38,.91,.72]} s={[.28,.12,.12]} c="#505b53"/></>:
+      <><Part p={[.2,.63,.32]} s={[.12,.12,.72]} c="#303a35" r={[.12,0,-.06]}/><Barrel p={[.2,.62,.75]} length={1.0} radius={.025} c="#252d2a"/>
+        {sniper&&<><Part p={[.2,.73,.58]} s={[.07,.09,.28]} c={accent}/><Part p={[.2,.66,.83]} s={[.11,.08,.2]} c="#1f2928"/></>}
+        {engineer&&<><Part p={[-.28,1.05,-.32]} s={[.22,.34,.2]} c={accent}/><Part p={[-.28,1.23,-.33]} s={[.26,.07,.22]} c="#3a4b42"/></>}
+        {anti&&<><Part p={[-.28,1.08,.05]} s={[.22,.22,.38]} c={dark}/><Barrel p={[-.28,1.07,.57]} length={1.25} radius={.09} c="#46534b"/><Round p={[-.28,1.07,1.2]} s={[.18,.18,.18]} c={accent}/></>}
