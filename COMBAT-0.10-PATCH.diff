+
+test('player units automatically retaliate against the specific enemy unit that hits them',()=>{
+  let state=isolated();
+  const defender=makeUnit(1,'infantry','player',0,0);
+  const attacker=makeUnit(101,'tank','enemy',4.5,0);
+  state.units=[defender,attacker];
+  const friendlyBase=state.baseHp,hostileBase=state.enemyHp;
+  state=advanceCombat(state,.1);
+  const returned=state.units.find(u=>u.id===1)!;
+  assert.equal(returned.order,'attack');
+  assert.equal(returned.targetId,101);
+  assert.equal(returned.targetBld??null,null);
+  assert.equal(state.baseHp,friendlyBase);
+  assert.equal(state.enemyHp,hostileBase);
+  const before=returned.x;
+  state=advanceCombat(state,.1);
+  assert(state.units.find(u=>u.id===1)!.x>before,'defender should close distance to the attacker');
+});
+
+test('being attacked does not make idle units march toward the enemy HQ',()=>{
+  let state=isolated();
+  state.units=[makeUnit(1,'infantry','player',0,0),makeUnit(101,'tank','enemy',4.5,0)];
+  state=advanceCombat(state,.1);
+  const defender=state.units.find(u=>u.id===1)!;
+  assert.equal(defender.targetId,101);
+  assert.notEqual(defender.targetId,-1);
+  assert.equal(defender.targetBld??null,null);
+});
+
+test('automatic fire chooses the nearest visible hostile unit inside weapon range',()=>{
+  let state=isolated();
+  const shooter=makeUnit(1,'infantry','player',0,0);
+  const nearest={...makeUnit(101,'infantry','enemy',2.5,0),cooldown:1};
+  const farther={...makeUnit(102,'infantry','enemy',3.4,0),cooldown:1};
+  state.units=[shooter,farther,nearest];
+  state=advanceCombat(state,.1);
+  assert(state.units.find(u=>u.id===101)!.hp<nearest.hp);
+  assert.equal(state.units.find(u=>u.id===102)!.hp,farther.hp);
+  assert(state.shots.some(s=>s.faction==='player'&&s.toX===nearest.x));
+});
+
+test('unit damage resolves into removal and kill credit with a visible shot effect',()=>{
+  let state=isolated();
+  state.units=[makeUnit(1,'heavy','player',0,0),{...makeUnit(101,'infantry','enemy',2,0),hp:1}];
+  state=advanceCombat(state,.1);
+  assert(!state.units.some(u=>u.id===101));
+  assert.equal(state.kills,1);
+  assert(state.shots.some(s=>s.faction==='player'&&s.toX===2));
+});
