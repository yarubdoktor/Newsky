+test('one hostile attacker triggers a shared target for the entire friendly combat force',()=>{
+  let state=isolated();
+  const infantry=makeUnit(1,'infantry','player',0,0);
+  const tank=makeUnit(2,'tank','player',-1,2);
+  const sniper=makeUnit(3,'sniper','player',1,3);
+  const worker=makeUnit(4,'worker','player',-3,1);
+  const supply=makeUnit(5,'supply','player',-4,2);
+  const attacker=makeUnit(101,'heavy','enemy',3,0);
+  state.units=[infantry,tank,sniper,worker,supply,attacker];
+  state=advanceCombat(state,.1);
+  for(const id of [1,2,3]){
+    const unit=state.units.find(u=>u.id===id)!;
+    assert.equal(unit.order,'attack',`combat unit ${id} should join the response`);
+    assert.equal(unit.targetId,101,`combat unit ${id} should share the same threat target`);
+  }
+  assert.notEqual(state.units.find(u=>u.id===4)!.targetId,101,'workers must not be pulled into combat');
+  assert.notEqual(state.units.find(u=>u.id===5)!.targetId,101,'supply vehicles must not be pulled into combat');
+});
+
+test('collective defense does not replace an explicit HQ attack order',()=>{
+  let state=isolated();
+  const ordered={...makeUnit(1,'heavy','player',0,0),order:'attack' as const,targetId:-1};
+  const defender=makeUnit(2,'infantry','player',0,2);
+  const attacker=makeUnit(101,'heavy','enemy',3,0);
+  state.units=[ordered,defender,attacker];
+  state=advanceCombat(state,.1);
+  assert.equal(state.units.find(u=>u.id===1)!.targetId,-1);
+  assert.equal(state.units.find(u=>u.id===2)!.targetId,101);
+});
